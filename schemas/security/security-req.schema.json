{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-sdlc.org/schemas/security/security-req.schema.json",
  "title": "Security Requirement Schema (Strict Test Validation Enforced)",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "status",
    "version",
    "security-domain",
    "mitigates-abuse-case"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SEC-REQ-[A-Z0-9]+(-[A-Z0-9]+)*$"
    },
    "type": {
      "type": "string",
      "const": "security-requirement"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$",
      "description": "Security requirement semantic version (SemVer)."
    },
    "schema-version": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "deprecated",
        "retired"
      ]
    },
    "security-domain": {
      "type": "string",
      "enum": [
        "authentication",
        "authorization",
        "cryptography",
        "input-validation",
        "audit-logging",
        "communication-security",
        "data-protection"
      ]
    },
    "mitigates-abuse-case": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^ABUSE-[A-Z0-9]+(-[A-Z0-9]+)*$"
      },
      "description": "Product/Security Traceability: Abuse case or threat this control neutralizes."
    },
    "enforced-in-enclave": {
      "type": "string",
      "pattern": "^SEC-ENC-[A-Z0-9]+(-[A-Z0-9]+)*$",
      "description": "Architecture Traceability: Perimeter or internal security enclave."
    },
    "compliance-references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance-format": {
      "type": "string",
      "enum": [
        "gherkin",
        "declarative-prose"
      ],
      "description": "Mitigation criteria format."
    },
    "cucumber-tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^@[a-zA-Z0-9_-]+$"
      }
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^SEC-REQ-[A-Z0-9]+(-[A-Z0-9]+)*$"
    },
    "superseded-by": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^SEC-REQ-[A-Z0-9]+(-[A-Z0-9]+)*$"
    }
  },
  "additionalProperties": false
}