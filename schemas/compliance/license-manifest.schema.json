{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-sdlc.org/schemas/compliance/license-manifest.schema.json",
  "title": "Static Dependencies License Manifest Schema",
  "type": "object",
  "required": [
    "evaluated_dependencies"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(MAN-LIC|LIC-MAN|LIC)-[A-Z0-9]+(-[A-Z0-9]+)*$",
      "description": "Optional canonical artifact identifier."
    },
    "type": {
      "type": "string",
      "const": "license-manifest"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?(-[0-9A-Za-z.-]+)?$",
      "description": "Manifest format version."
    },
    "schema-version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "evaluated_dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "package",
          "version",
          "spdx_license",
          "status"
        ],
        "properties": {
          "package": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "spdx_license": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "APPROVED",
              "REJECTED",
              "REVIEW_REQUIRED",
              "COMMERCIAL_APPROVAL_REQUIRED",
              "PENDING"
            ]
          },
          "reason": {
            "type": "string"
          },
          "approved_by": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}