{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-sdlc.org/schemas/safety/hazard.schema.json",
  "title": "Hazard Schema (Operational Hazard & Safety Risk Analysis)",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "status",
    "version",
    "severity",
    "probability",
    "fault-tolerance-time-ms",
    "mitigated-by"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^HAZ-[A-Z0-9]+(-[A-Z0-9]+)*$"
    },
    "type": {
      "type": "string",
      "const": "hazard"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$",
      "description": "Hazard semantic version (SemVer)."
    },
    "schema-version": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "deprecated",
        "retired"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "catastrophic",
        "critical",
        "major",
        "minor",
        "negligible"
      ],
      "description": "Hazard severity per functional safety classification (DO-178C / ISO 26262)."
    },
    "probability": {
      "type": "string",
      "enum": [
        "frequent",
        "probable",
        "occasional",
        "remote",
        "improbable",
        "extremely-improbable"
      ],
      "description": "Probability of operational hazard occurrence."
    },
    "fault-tolerance-time-ms": {
      "type": "number",
      "minimum": 0,
      "description": "Fault tolerance time interval (FTTI) limit in milliseconds before entering safe state."
    },
    "mitigated-by": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^SAF-REQ-[A-Z0-9]+(-[A-Z0-9]+)*$"
      },
      "description": "Safety requirements mitigating this hazard."
    },
    "hazardous-condition": {
      "type": "string",
      "description": "Description of the dangerous operational condition."
    },
    "potential-effect": {
      "type": "string",
      "description": "Potential effect on people, aircraft, or environment if hazard materializes."
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "superseded-by": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}