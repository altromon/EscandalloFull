{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-sdlc.org/schemas/workflow/agent-handoff.schema.json",
  "title": "Agent Workflow Handoff Block Schema",
  "type": "object",
  "required": [
    "id",
    "type",
    "completed-phase",
    "acting-role",
    "autonomy-mode",
    "deliverables",
    "suggested-prompt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(AHOF|HOF-WORKFLOW|HOF)-[A-Z0-9]+(-[A-Z0-9]+)*$",
      "description": "Unique workflow handoff identifier."
    },
    "type": {
      "type": "string",
      "const": "agent-handoff"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$",
      "description": "Semantic versioning (SemVer)."
    },
    "schema-version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "completed",
        "transferred"
      ]
    },
    "completed-phase": {
      "type": "string",
      "minLength": 2,
      "description": "Name of the completed lifecycle phase or activity."
    },
    "acting-role": {
      "type": "string",
      "enum": [
        "agent-product-analyst",
        "agent-threat-modeler",
        "agent-system-architect",
        "agent-qa-engineer",
        "agent-developer",
        "agent-expert-user",
        "agent-security-auditor",
        "agent-compliance-checker",
        "agent-code-reviewer",
        "agent-devops",
        "human-dev",
        "tech-lead",
        "release-manager"
      ],
      "description": "Specialized role executing the handoff."
    },
    "autonomy-mode": {
      "type": "string",
      "enum": [
        "AUTONOMOUS",
        "HUMAN_REVIEW_PLAN",
        "AMBIGUOUS",
        "HIGH_RISK_MANUAL"
      ],
      "description": "Autonomy level under which the task was executed."
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Paths or IDs of artifacts produced during the phase."
    },
    "recommended-next-roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "rationale"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "description": "Recommended downstream specialist roles and technical justifications."
    },
    "suggested-prompt": {
      "type": "string",
      "minLength": 5,
      "description": "Suggested invocation prompt to initiate the next agent."
    },
    "human-action-window": {
      "type": "object",
      "properties": {
        "review-and-validate": {
          "type": "boolean"
        },
        "edit-directly": {
          "type": "boolean"
        },
        "pause-or-divert": {
          "type": "boolean"
        },
        "delegate": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "description": "Actions available to the human engineer within the sovereign action window."
    }
  },
  "additionalProperties": false
}