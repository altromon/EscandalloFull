{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-sdlc.org/schemas/architecture/component.schema.json",
  "title": "NAF v4 / arc42 Architecture Component Schema (Multilevel)",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "status",
    "version",
    "level",
    "implementation-type",
    "implements-use-cases"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CMP-[A-Z0-9]+(-[A-Z0-9]+)*$"
    },
    "type": {
      "type": "string",
      "const": "component"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$",
      "description": "Architecture component semantic version (SemVer)."
    },
    "schema-version": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "accepted",
        "deprecated",
        "retired"
      ]
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "description": "Hierarchical architecture level (1: Bounded Context / Root System, 2: Subsystem / Container, 3: Executable Unit / DLL / Function)."
    },
    "bounded-context": {
      "type": "string",
      "description": "Domain-Driven Design (DDD) Bounded Context name this component belongs to."
    },
    "parent-component": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^CMP-[A-Z0-9]+(-[A-Z0-9]+)*$",
      "description": "Parent component identifier (null if Level 1)."
    },
    "implementation-type": {
      "type": "string",
      "enum": [
        "service",
        "dll",
        "function",
        "composite"
      ],
      "description": "Technical implementation paradigm: distributed service (service), dynamic/native library (dll), in-process module/function (function), or logical aggregator/Bounded Context (composite)."
    },
    "implements-use-cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^UC-[A-Z0-9]+(-[A-Z0-9]+)*$"
      }
    },
    "satisfies-requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(FR|QR|CON|SEC-REQ)-[A-Z0-9]+(-[A-Z0-9]+)*$"
      }
    },
    "hosted-in-enclave": {
      "type": "string",
      "pattern": "^SEC-ENC-[A-Z0-9]+(-[A-Z0-9]+)*$",
      "description": "Security enclave where the component resides (optional for DLLs or in-process functions)."
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "protocol"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "protocol": {
            "type": "string",
            "enum": [
              "REST/HTTP",
              "gRPC",
              "WebSocket",
              "Kafka",
              "MQTT",
              "C-ABI",
              "Native-ABI",
              "FFI",
              "In-Process API",
              "Function-Call",
              "CLI",
              "GUI",
              "IPC"
            ]
          },
          "contract-spec": {
            "type": "string"
          }
        }
      }
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^CMP-[A-Z0-9]+(-[A-Z0-9]+)*$"
    },
    "superseded-by": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^CMP-[A-Z0-9]+(-[A-Z0-9]+)*$"
    }
  },
  "additionalProperties": false
}