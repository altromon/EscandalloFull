{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-sdlc.org/schemas/architecture/adr.schema.json",
  "title": "Architecture Decision Record Schema (Versionable)",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "status",
    "version",
    "deciders",
    "decision-date"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ADR-[0-9]{3,4}(-[A-Z0-9]+)*$"
    },
    "type": {
      "type": "string",
      "const": "architecture-decision-record"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$",
      "description": "Decision record semantic version (SemVer)."
    },
    "schema-version": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "accepted",
        "rejected",
        "deprecated",
        "superseded"
      ]
    },
    "deciders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "decision-date": {
      "type": "string",
      "format": "date"
    },
    "affects-components": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CMP-[A-Z0-9]+(-[A-Z0-9]+)*$"
      }
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ADR-[0-9]{3,4}(-[A-Z0-9]+)*$"
    },
    "superseded-by": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ADR-[0-9]{3,4}(-[A-Z0-9]+)*$"
    }
  },
  "additionalProperties": false
}